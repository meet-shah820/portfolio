PORT=5000
# The API loads server/.env first, then server/env.example if MONGODB_URI is still empty.
# Prefer creating server/.env (private) for secrets; avoid committing real passwords in env.example.
MONGODB_URI=your_mongodb_uri_here

# Optional: password for admin profile editing (POST /api/profile/verify-edit, PUT /api/profile).
# PROFILE_EDIT_PASSWORD=11232005
